<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restore from nuget.org only, whatever feeds the machine has configured
       globally. Central package management refuses to run with more than one
       unmapped source, and a public repository should not build differently
       depending on whose machine it is on. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
