<Project>

  <!-- Settings every project shares, so a new one starts out consistent. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- QUIC is supported on Windows, Linux and macOS but not every target
         .NET can build for. The library checks QuicListener.IsSupported at
         startup and throws a clear error, so the per-call platform warnings
         are noise that buries real ones. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <!-- Nothing is packable unless it opts in. Only Tailcat.Link is published:
         the libraries below it exist to serve it, are named after someone
         else's project, and ship inside its package rather than beside it on
         nuget.org. -->
    <IsPackable>false</IsPackable>

    <Authors>Andrzej Ból</Authors>
    <Company>Andrzej Ból</Company>
    <Copyright>Copyright (c) 2020 Tailscale Inc &amp; contributors; (c) 2026 Andrzej Ból and contributors</Copyright>
    <Product>Tailcat for .NET</Product>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/b-y-t-e/tailcat-link</PackageProjectUrl>
    <RepositoryUrl>https://github.com/b-y-t-e/tailcat-link</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>0.3.1</VersionPrefix>

    <!-- Packages ship with symbols and with the sources they were built from
         embedded, so a stack trace from a consumer's machine points at a line
         rather than at an address. ContinuousIntegrationBuild is what makes
         the build deterministic; it is set only on CI because it rewrites
         local source paths, which is unhelpful while debugging here. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
