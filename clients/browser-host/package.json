{
  "name": "@tailcat/link-host",
  "version": "0.1.0",
  "description": "Host a Tailcat link from a page or from Node: publish an invitation, admit the machines that join",
  "type": "module",
  "license": "BSD-3-Clause",
  "exports": {
    ".": "./src/index.js",
    "./file-store": "./src/file-store.js"
  },
  "files": ["src"],
