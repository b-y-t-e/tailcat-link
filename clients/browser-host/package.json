  "scripts": {
    "test": "node --test --test-timeout=60000 \"test/unit/*.test.mjs\"",
    "example": "node examples/demo/serve.mjs",
    "live": "node test/live.mjs"
  },
  "peerDependencies": {
    "@tailcat/link": "0.1.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@tailcat/link": "file:../browser",
    "tweetnacl": "1.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
