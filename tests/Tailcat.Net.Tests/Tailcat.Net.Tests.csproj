<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <RootNamespace>Tailcat.Net.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tailcat.Net\Tailcat.Net.csproj" />
    <ProjectReference Include="..\Tailcat.TestSupport\Tailcat.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The relay1 vectors live with the JavaScript client, because that is the
         implementation they exist to hold this one against. -->
    <None Include="..\..\clients\browser\test\vectors\relay1-records.json" CopyToOutputDirectory="PreserveNewest" Link="relay1-records.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- PeerLink's constructor is internal: it is built by a node, not by hand. -->
    <Using Include="Tailcat.Net" />
  </ItemGroup>

</Project>
