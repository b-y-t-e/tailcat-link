<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <RootNamespace>Tailcat.Link.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tailcat.Link\Tailcat.Link.csproj" />
    <!-- Tailcat.Link marks this reference PrivateAssets="all" so it does
         not become a package dependency, which also stops it flowing
         through to here. The end-to-end tests build nodes directly, so
         they name it themselves. -->
    <ProjectReference Include="..\..\src\Tailcat.Net\Tailcat.Net.csproj" />
    <ProjectReference Include="..\Tailcat.TestSupport\Tailcat.TestSupport.csproj" />
  </ItemGroup>

</Project>
