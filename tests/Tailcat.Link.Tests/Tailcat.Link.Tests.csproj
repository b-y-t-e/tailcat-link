<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <RootNamespace>Tailcat.Link.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tailcat.Link\Tailcat.Link.csproj" />
    <!-- Tailcat.Link marks this reference PrivateAssets="all" so it does
         not become a package dependency, which also stops it flowing
         through to here. The end-to-end tests build nodes directly, so
         they name it themselves. -->
    <ProjectReference Include="..\..\src\Tailcat.Net\Tailcat.Net.csproj" />
    <ProjectReference Include="..\..\src\Tailcat.Link.Extensions.DependencyInjection\Tailcat.Link.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\Tailcat.Link.Json\Tailcat.Link.Json.csproj" />
    <ProjectReference Include="..\Tailcat.TestSupport\Tailcat.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same file the browser client's unit tests read. It is what holds
         the two implementations of the hello and the channel to the same
         bytes offline; the interop run needs a live relay and a host. -->
    <None Include="..\..\clients\browser\test\vectors\link-frames.json"
          CopyToOutputDirectory="PreserveNewest" Link="link-frames.json" />
  </ItemGroup>

</Project>
