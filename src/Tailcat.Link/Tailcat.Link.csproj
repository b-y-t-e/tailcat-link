<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Tailcat.Link</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <!-- The only package published from this repository. Tailcat, Tailcat.Derp
         and Tailcat.Net are named after someone else's project and exist to
         serve this one, so they ship inside this package rather than beside it
         on nuget.org. -->
    <IsPackable>true</IsPackable>
    <PackageId>Tailcat.Link</PackageId>
    <Title>Tailcat.Link — a durable link between two machines</Title>
    <Description>Pair two machines that cannot see each other with a short code, once, then send and receive for as long as they are switched on. The link re-establishes itself after a network change, a relay outage, or either machine rebooting, and the identity that makes that possible is stored encrypted (DPAPI on Windows, 0600 inside a 0700 directory on Unix).</Description>
    <PackageTags>tailscale;tailcat;derp;nat-traversal;hole-punching;quic;p2p;remote-control;networking</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>First release. Pairing, a durable session over DERP with a direct QUIC path when hole punching succeeds, and a stored identity that survives a reboot. Hole punching between two different NATs is untested; see the repository README.</PackageReleaseNotes>
    <!-- The public surface is fully documented, so consumers get IntelliSense
         from the package rather than from guessing. The repository as a whole
         is not there yet, which is why this is set here and not in
         Directory.Build.props. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Bundled dependencies">
    <!-- The four project references below are not published separately, so
         their assemblies go into this package's lib/ folder. Without this the
         package would declare dependencies that resolve nowhere. -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeReferencedProjectsInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeReferencedProjectsInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference')->WithMetadataValue('Extension', '.dll'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Packed at the package root, where nuget.org looks for it. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI: on Windows the stored identity key is encrypted to the user
         account, so a readable file is not a usable key. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <!-- Transitive through the bundled assemblies rather than through NuGet,
         because the projects that reference them are not packages. Declared
         here so a consumer still gets them restored. -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Sodium.Core" />
    <PackageReference Include="System.Formats.Cbor" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tailcat.Link.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets: these are not packages, so they must not appear in the
         nuspec as dependencies. Their assemblies are bundled instead, by the
         IncludeReferencedProjectsInPackage target above. -->
    <ProjectReference Include="..\Tailcat.Net\Tailcat.Net.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
