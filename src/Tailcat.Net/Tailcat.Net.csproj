<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Tailcat.Net</RootNamespace>
    <!-- This assembly ships inside the Tailcat.Link package, so its XML docs
         have to be built for a consumer to get IntelliSense on the types that
         surface through Tailcat.Link. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sodium.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- A PeerLink is created by a node, so its constructor is internal;
         the tests build one directly to exercise path selection. -->
    <InternalsVisibleTo Include="Tailcat.Net.Tests" />
    <!-- Tailcat.Link's end-to-end tests stand whole nodes up against the
         in-memory relay, which is what ConnectRelay exists for. -->
    <InternalsVisibleTo Include="Tailcat.Link.Tests" />
    <!-- ConnectRelay is the seam a whole node is stood up against an in-memory
         relay through, and Tailcat.TestSupport is what ships that to
         consumers. It stays internal: what they use is the gateway factory. -->
    <InternalsVisibleTo Include="Tailcat.TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tailcat\Tailcat.csproj" />
    <ProjectReference Include="..\Tailcat.Derp\Tailcat.Derp.csproj" />
  </ItemGroup>

</Project>
