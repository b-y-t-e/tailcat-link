<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Tailcat.Derp</RootNamespace>
    <!-- This assembly ships inside the Tailcat.Link package, so its XML docs
         have to be built for a consumer to get IntelliSense on the types that
         surface through Tailcat.Link. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sodium.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Liveness timings are internal constants; the tests run the same logic on a shorter clock. -->
    <InternalsVisibleTo Include="Tailcat.Derp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tailcat\Tailcat.csproj" />
  </ItemGroup>

</Project>
